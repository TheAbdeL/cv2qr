# Copy this file to ".env.local" and fill in your Supabase values.
# Find them in your Supabase project: Settings → API.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The SERVICE ROLE key (secret!). Used only on the server. Never expose it
# in client code or commit the real .env.local file.
SUPABASE_SERVICE_ROLE_KEY=
